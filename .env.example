# Photo runners ("run as yourself"). Server-side only; copy to .env.local. First configured provider wins.
# 1) Viggle public API (recommended): key from the Viggle developer dashboard.
VIGGLE_API_KEY=
# Optional: if the API needs a fetchable image_url instead of a file upload, set this server's public origin.
PUBLIC_BASE_URL=
# 2) PINOC asset-hub with a personal bearer token (~30 days). Prefix/host as in pinoc-motion-mvp/.env.example.
PINOC_TOKEN=
PINOC_API_PREFIX=
PINOC_API_HOST=
# 3) No credits: fake a 20 s generation that returns a bundled character (UI testing).
RUNNER_MOCK=
# Credit guardrails (each photo costs ~10 credits)
RUNNER_PER_IP_PER_DAY=3
RUNNER_PER_DAY=30
